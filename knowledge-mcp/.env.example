# Copy to .env in this directory. The server and ingestion load it automatically.
QDRANT_URL=http://127.0.0.1:6333
DENSE_COLLECTION=documents
MODEL_NAME=intfloat/multilingual-e5-small
# auto uses CUDA when PyTorch can access an NVIDIA GPU; cpu forces CPU.
EMBEDDING_DEVICE=auto
# Bind to 127.0.0.1 by default. Use 0.0.0.0 only behind an authenticated proxy.
MCP_HOST=127.0.0.1
MCP_PORT=8000
# Optional bearer-token auth for the MCP endpoint. Disabled by default.
# Prefer configuring this from the dashboard Settings page instead.
# MCP_AUTH_ENABLED=0
# MCP_AUTH_TOKEN=a-long-random-token
# MCP_TRANSPORT=streamable-http   # streamable-http | sse | stdio
# MCP_PATH=/mcp                  # streamable-http endpoint path
# MCP_STATELESS=0                # 1 for proxies that do not keep session IDs
# MCP_JSON_RESPONSE=0            # 1 for plain JSON instead of an SSE stream
# Warm the embedding model at startup so the first query is fast.
# MCP_PRELOAD_MODEL=1

# Access control (dashboard Settings writes these for managed installs).
# Sensitive directory names, denied at any depth in ingestion and retrieval.
# ACL_DENY_DIRECTORIES=private,hr,legal
# Optional lexical bigrams improve phrase matching (re-index after changing).
# LEXICAL_BIGRAMS=0

# Set to an existing local directory or a read-only mounted share.
KNOWLEDGE_ROOT=/path/to/knowledge/root
# Optional: defaults to knowledge-mcp/.state
# INGESTION_BASE_DIR=/var/lib/knowledge-mcp
# Optional: defaults to knowledge-mcp/mcp/index-policy.yaml
# POLICY_FILE=/opt/knowledge-mcp/knowledge-mcp/mcp/index-policy.yaml

CHUNK_SIZE=1200
CHUNK_OVERLAP=200
# Short passages are retained. The tokenizer splits further when the model needs it.
EMBED_BATCH_SIZE=32
